# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studysphere

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary — used for lesson videos/PDFs, assignment attachments,
# and notes/PYQ uploads (create a free account at cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outgoing email (used for notifications, e.g. course approval)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=StudySphere <no-reply@studysphere.demo>

# Frontend origin allowed to call this API (CORS). Set to your deployed
# frontend URL in production, e.g. https://studysphere.vercel.app
CLIENT_URL=http://localhost:5173

# Server port
PORT=5000
NODE_ENV=development
